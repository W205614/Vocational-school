  "components": {
    "schemas": {
      "UserFormDTO": {
        "type": "object",
        "default": null,
        "description": "修改用户信息的表单，带有密码",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "description": "用户id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "cellPhone": {
            "type": "string",
            "default": "",
            "description": "手机",
            "example": "13890011009",
            "pattern": "^1([38][0-9]|4[579]|5[0-3,5-9]|6[6]|7[0135678]|9[89])\\d{8}$"
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "用户名称/昵称",
            "example": "李四"
          },
          "type": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "用户类型，1-其他员工,2-普通学员，3-老师",
            "example": 2
          },
          "roleId": {
            "type": "string",
            "default": "",
            "description": "角色id，老师和学生不用填",
            "example": 5,
            "pattern": "^-?[0-9]+$"
          },
          "icon": {
            "type": "string",
            "default": "",
            "description": "头像",
            "example": "default-user-icon.jpg"
          },
          "job": {
            "type": "string",
            "default": "",
            "description": "岗位",
            "example": "讲师"
          },
          "intro": {
            "type": "string",
