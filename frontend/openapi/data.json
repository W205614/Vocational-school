          "version": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "type": "integer",
            "format": "int32",
            "maximum": 9,
            "minimum": 1
          },
          "data": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "maxItems": 15,
            "minItems": 15
          }
        },
        "required": [
          "data",
          "type",
          "version"
        ]
      },
