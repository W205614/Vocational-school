        "summary": "查询我的兴趣爱好",
        "operationId": "queryMyInterests",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "msg",
                    "data",
                    "requestId"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "msg": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CategoryBasicDTO"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "课程推荐相关接口"
        ],
        "summary": "新增兴趣爱好",
        "operationId": "saveMyInterests",
        "parameters": [
          {
            "name": "interestedIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^-?[0-9]+$"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
