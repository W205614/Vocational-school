  "components": {
    "schemas": {
      "CourseVO": {
        "type": "object",
        "default": null,
        "description": "课程信息",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "description": "课程id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "课程名称",
            "example": "Java"
          },
          "price": {
            "type": "string",
            "default": "",
            "description": "课程价格，单位分",
            "example": 32900,
            "pattern": "^-?[0-9]+$"
          },
          "teacher": {
            "type": "string",
            "default": "",
            "description": "老师名字",
            "example": "张老师"
          },
          "icon": {
            "type": "string",
            "default": "",
            "description": "老师头像",
            "example": "default-user-icon.jpg"
          },
          "duration": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "课程时长，单位秒",
            "example": 3280
          },
          "coverUrl": {
            "type": "string",
            "default": "",
            "description": "课程封面地址",
            "example": "default-cover-url.jpg"
          },
          "sections": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "课程章节数量",
            "example": 25
          },
          "sold": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "课程报名人数（销量）",
            "example": 3920
          }
        }
      },
      "CategoryBasicDTO": {
        "type": "object",
        "default": null,
        "description": "分类id和名称信息",
        "properties": {
          "id": {
            "type": "string",
            "default": "",
            "description": "分类id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "name": {
            "type": "string",
            "default": "",
            "description": "分类名称",
            "example": "Java"
          },
          "parentId": {
            "type": "string",
            "default": "",
            "description": "父分类id",
            "example": 0,
            "pattern": "^-?[0-9]+$"
          }
        }
      },
      "CoursePageQuery": {
        "type": "object",
        "default": null,
        "description": "课程搜索条件",
        "properties": {
          "pageNo": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "maximum": 100,
            "minimum": 1
          },
          "isAsc": {
            "type": "boolean"
          },
          "sortBy": {
            "type": "string"
          },
          "keyword": {
            "type": "string",
            "default": "",
            "description": "搜索关键字",
            "example": "Redis"
          },
          "categoryIdLv1": {
            "type": "string",
            "default": "",
            "description": "课程1级分类id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "categoryIdLv2": {
            "type": "string",
            "default": "",
            "description": "课程2级分类id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "categoryIdLv3": {
            "type": "string",
            "default": "",
            "description": "课程3级分类id",
            "example": 1,
            "pattern": "^-?[0-9]+$"
          },
          "free": {
            "type": "boolean",
            "default": false,
            "description": "售卖模式，true：免费，false：收费",
            "example": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "default": "",
            "description": "课程状态，1：待上架，2：已上架，3：已下架，4：已完结",
            "example": 1
          },
          "type": {
