<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zhixuetang</groupId>
        <artifactId>zxt-compact</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>zxt-education-app</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.zhixuetang</groupId>
            <artifactId>zxt-compact-runtime</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.zhixuetang</groupId>
            <artifactId>zxt-course</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.zhixuetang</groupId>
            <artifactId>zxt-learning</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.zhixuetang</groupId>
            <artifactId>zxt-exam</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.zhixuetang</groupId>
            <artifactId>zxt-remark</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
    <build>
        <finalName>zxt-education-app</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>com.zhixuetang.compact.EducationApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
