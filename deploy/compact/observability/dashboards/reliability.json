{
  "uid": "tianji-reliability",
  "title": "Zhixuetang Reliability",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Module availability",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [{ "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 2,
      "title": "Oldest durable event (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [{ "expr": "zxt_events_oldest_seconds", "legendFormat": "{{job}}" }]
    },
    {
      "id": 3,
      "title": "Failures requiring review",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [
        {
          "expr": "{__name__=~\"zxt_events_dead|zxt_consumer_failures|zxt_operations_retry_exhausted|zxt_payment_reconciliation_dead|zxt_payment_anomalies|zxt_seasons_blocked\"}",
          "legendFormat": "{{__name__}} {{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Hours since verified full backup",
      "type": "stat",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [{ "expr": "(time() - zxt_backup_last_success_timestamp_seconds) / 3600" }]
    },
    {
      "id": 5,
      "title": "Oldest pending business operation (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [{ "expr": "zxt_operations_oldest_seconds", "legendFormat": "{{job}}" }]
    },
    {
      "id": 6,
      "title": "Reliability metrics age (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "compact-prometheus" },
      "targets": [
        {
          "expr": "time() - zxt_reliability_metrics_last_success_timestamp_seconds",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
