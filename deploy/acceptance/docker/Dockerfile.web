FROM nginx:1.27.5-alpine
COPY dist/ /usr/share/nginx/html/
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV GW_UPSTREAM=app-gateway:23310
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1:8080/api/v2/environment || exit 1
