FROM nginx:1.30.8-alpine@sha256:8eb04fe3b385090e9aa02961f77398ad09b6bf33ab07f6669a5bb7acce22c0d3
RUN apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0' 'curl>=8.23.0-r0' 'libcurl>=8.23.0-r0' 'libexpat>=2.11.0-r0' 'libxslt>=1.1.43-r4' \
    'libcrypto3>=3.5.9-r1' 'libssl3>=3.5.9-r1'
COPY dist/ /usr/share/nginx/html/
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV GW_UPSTREAM=app-gateway:23310
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=10 CMD wget -q -O /dev/null http://127.0.0.1:8080/api/v2/environment || exit 1
