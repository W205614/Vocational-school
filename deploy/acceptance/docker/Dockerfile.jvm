FROM eclipse-temurin:21-jre-alpine@sha256:b6ea71e690a72ba240b3d1b5c477410014862f9ea2cc73ab40e41ff21b03ba1c
RUN apk add --no-cache --upgrade tzdata 'zlib>=1.4-r0'
ENV TZ=Asia/Shanghai
WORKDIR /app
RUN addgroup -g 10001 app && adduser -D -H -u 10001 -G app app && mkdir -p /app/logs/csp && chown app:app /app/logs /app/logs/csp
COPY --chown=app:app app.jar /app/app.jar
COPY --chown=app:app HealthProbe.class /app/health/HealthProbe.class
USER app
ENTRYPOINT ["java","-Xms96m","-Xmx384m","-XX:MaxDirectMemorySize=64m","-XX:ActiveProcessorCount=2","-jar","/app/app.jar","--spring.config.location=file:/run/acceptance/application.yml"]
