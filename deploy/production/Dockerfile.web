# Supply an audited immutable nginx runtime, e.g. nginx@sha256:<approved digest>.
ARG NGINX_IMAGE=nginx@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951
FROM ${NGINX_IMAGE}
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
USER root
RUN apk add --no-cache --upgrade 'brotli-libs>=1.2.1-r0' 'curl>=8.23.0-r0' 'libcurl>=8.23.0-r0'
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app \
    && mkdir -p /var/cache/nginx /var/run /etc/nginx/conf.d \
    && chown -R app:app /var/cache/nginx /var/run /etc/nginx/conf.d
COPY dist/ /usr/share/nginx/html/
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV GW_UPSTREAM=app-gateway:24310
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=4 CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
