log_format tianji_safe '$request_method $uri $status $body_bytes_sent $request_time';
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    access_log /dev/stdout tianji_safe;
    error_log /dev/stderr crit;
    client_max_body_size 201m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        try_files $uri $uri/ /index.html;
    }
    # Public /api is routed directly to the gateway by the mesh VirtualService.
    # Reject a mistaken fallback instead of losing the ingress HTTPS identity.
    location /api/ { return 404; }
}
