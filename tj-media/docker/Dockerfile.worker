FROM eclipse-temurin:21-jre-noble@sha256:35501d3f93173b420ac9001658eb68157e813316b865087e345c187fca422c4c
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg clamav curl && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --home /app app \
    && mkdir -p /app /work/media && chown app:app /app /work/media
WORKDIR /app
COPY tj-media-worker.jar /app/app.jar
USER 10001:10001
EXPOSE 8086
HEALTHCHECK --interval=15s --timeout=4s --start-period=60s --retries=4 CMD curl -fsS http://127.0.0.1:8086/actuator/health || exit 1
ENTRYPOINT ["java","-Xms96m","-Xmx384m","-XX:ActiveProcessorCount=2","-jar","/app/app.jar"]
