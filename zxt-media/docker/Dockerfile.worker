FROM eclipse-temurin:21-jre-alpine@sha256:b6ea71e690a72ba240b3d1b5c477410014862f9ea2cc73ab40e41ff21b03ba1c
ARG VCS_REF
LABEL org.opencontainers.image.revision=$VCS_REF
RUN apk add --no-cache --upgrade tzdata 'zlib>=1.4-r0' ffmpeg clamav curl \
    && addgroup -g 10001 app && adduser -D -H -u 10001 -G app app \
    && mkdir -p /app /work/media && chown app:app /app /work/media
WORKDIR /app
COPY zxt-media-worker.jar /app/app.jar
USER 10001:10001
EXPOSE 8086
HEALTHCHECK --interval=15s --timeout=4s --start-period=60s --retries=4 CMD curl -fsS http://127.0.0.1:8086/actuator/health || exit 1
ENTRYPOINT ["java","-Xms96m","-Xmx384m","-XX:ActiveProcessorCount=2","-jar","/app/app.jar"]
